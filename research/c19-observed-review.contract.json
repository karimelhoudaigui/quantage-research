{
  "claim_id": "C19-OBSERVED-POSTTEST-AUDIT",
  "mathematics": {
    "assertion_tested": "Exact reconstruction of C19 observed fidelity, reviewer domains, selection, counterexamples, costs and recorded solver solution validity; bounded20cases80calls.",
    "coefficient_domain": "exact integer finite enumeration; conserved float probabilities and times",
    "conventions": "Use independent reviewer labels, never production scorer/parser imports. Auditor authored C19 corpus; this is distinct computation review, not independent author-blind corpus review.",
    "inputs": [
      "20public cases and reviewer labels+oracle",
      "80physical response records and HTTP+template traces, self13+7disjoint union",
      "80recorded solver portfolios and finalmetrics for comparison after reconstruction"
