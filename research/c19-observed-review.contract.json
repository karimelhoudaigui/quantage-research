    "bounds": {
      "cases": 20,
      "max_n": 7,
      "max_cube": 128,
      "calls": 80,
      "max_rows": 32,
      "max_AST_nodes": 256
    },
    "non_claims": [
      "No new inference, runtime or solver execution",
      "No population or causal modelcomparison claim",
      "No fully independent final reviewer; no novelty or QPU claim"
    ]
